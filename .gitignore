# Ignore the Unity Library folder
Library/

# Ignore the Unity obj folder
obj/

# Ignore the Unity Temp folder
Temp/

# Ignore the Visual Studio files that are automatically generated by Unity
*.sln
*.csproj
*.suo

# Ignore any test .psd files
*.psd
*.psd.meta

# Ignore the MonoDevelop .userprefs file
*.userprefs

# Ignore the StyleCop files
Settings.StyleCop
StyleCop.Cache
.omx/plans

# WorkBuddy 工作区数据（记忆、改动备份），不进版本库
.workbuddy/

# Python 字节码缓存（.agents/scripts 下的工具链产生）
__pycache__/
*.pyc

# AI 清理会话的 plan 是运行产物，一律放 Library/PrefabCleanupPlans/（Library/ 已忽略）。
# 此规则是保险：万一又有会话往 skill 目录里写 plan，也不会进版本库。
.agents/skills/*/plans/
