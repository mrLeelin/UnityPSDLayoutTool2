.psd-hierarchy-chat {
    flex-grow: 1;
    padding: 12px;
    background-color: rgb(31, 34, 39);
}

.psd-hierarchy-chat-header {
    padding: 12px;
    margin-bottom: 10px;
    background-color: rgb(42, 47, 54);
    border-left-width: 3px;
    border-left-color: rgb(93, 158, 229);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(66, 73, 82);
    border-right-color: rgb(66, 73, 82);
    border-bottom-color: rgb(66, 73, 82);
}

.psd-hierarchy-chat-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.psd-hierarchy-chat-title {
    color: rgb(244, 246, 249);
    font-size: 15px;
    unity-font-style: bold;
}

.psd-hierarchy-chat-target-caption {
    margin-top: 10px;
    color: rgb(150, 161, 174);
    font-size: 10px;
}

.psd-hierarchy-chat-target {
    margin-top: 2px;
    color: rgb(207, 214, 223);
    font-size: 11px;
    white-space: normal;
}

.psd-hierarchy-chat-agent-info {
    margin-top: 8px;
    color: rgb(190, 216, 242);
    font-size: 11px;
    white-space: normal;
}

.psd-hierarchy-chat-resource-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 9px;
}

.psd-hierarchy-chat-resource-button {
    height: 24px;
    margin-right: 6px;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    color: rgb(196, 220, 242);
    background-color: rgb(48, 78, 106);
    border-width: 1px;
    border-color: rgb(77, 119, 153);
    font-size: 10px;
}

.psd-hierarchy-chat-resource-button:hover {
    background-color: rgb(57, 94, 126);
    border-color: rgb(112, 165, 207);
}

.psd-hierarchy-chat-resource-button:disabled {
    color: rgb(135, 145, 156);
    background-color: rgb(54, 58, 64);
    border-color: rgb(73, 78, 86);
}

.psd-hierarchy-chat-open-cli {
    align-self: flex-start;
    height: 24px;
    margin-top: 7px;
    padding-left: 8px;
    padding-right: 8px;
    color: rgb(201, 232, 214);
    background-color: rgb(48, 88, 66);
    border-width: 1px;
    border-color: rgb(76, 132, 98);
    font-size: 10px;
}

.psd-hierarchy-chat-open-cli:hover {
    background-color: rgb(59, 106, 79);
    border-color: rgb(108, 168, 128);
}

.psd-hierarchy-chat-open-cli:disabled {
    color: rgb(135, 145, 156);
    background-color: rgb(54, 58, 64);
    border-color: rgb(73, 78, 86);
}

.psd-hierarchy-chat-open-local-repair {
    align-self: flex-start;
    height: 24px;
    margin-top: 7px;
    margin-left: 6px;
    padding-left: 8px;
    padding-right: 8px;
    color: rgb(246, 224, 184);
    background-color: rgb(91, 72, 44);
    border-width: 1px;
    border-color: rgb(155, 119, 65);
    font-size: 10px;
}

.psd-hierarchy-chat-open-local-repair:hover {
    background-color: rgb(112, 88, 51);
    border-color: rgb(212, 167, 91);
}

.psd-local-repair-panel {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 10px;
    background-color: rgb(42, 47, 54);
    border-width: 1px;
    border-color: rgb(66, 73, 82);
}

.psd-hierarchy-local-repair .unity-base-field__label {
    min-width: 108px;
}

.psd-hierarchy-chat-messages {
    flex-grow: 1;
    min-height: 300px;
    padding: 8px;
    background-color: rgb(25, 28, 32);
    border-width: 1px;
    border-color: rgb(57, 63, 70);
}

.psd-hierarchy-chat-message {
    position: relative;
    margin-bottom: 8px;
    padding: 9px 38px 9px 10px;
    border-left-width: 3px;
    border-left-color: rgb(104, 113, 124);
    background-color: rgb(45, 50, 57);
}

.psd-hierarchy-chat-message-user {
    border-left-color: rgb(93, 158, 229);
    background-color: rgb(42, 53, 67);
}

.psd-hierarchy-chat-message-assistant {
    border-left-color: rgb(89, 181, 135);
    background-color: rgb(42, 55, 49);
}

.psd-hierarchy-chat-message-system {
    border-left-color: rgb(217, 170, 77);
    background-color: rgb(59, 53, 42);
}

.psd-hierarchy-chat-thinking {
    margin-bottom: 8px;
    padding: 9px 10px;
    border-left-width: 3px;
    border-left-color: rgb(89, 181, 135);
    background-color: rgb(38, 57, 49);
}

.psd-hierarchy-chat-thinking-content {
    margin-top: 5px;
    color: rgb(185, 226, 202);
    font-size: 12px;
    white-space: normal;
}

.psd-hierarchy-chat-message-role {
    color: rgb(170, 181, 194);
    font-size: 10px;
    unity-font-style: bold;
}

.psd-hierarchy-chat-message-content {
    margin-top: 5px;
    color: rgb(239, 242, 246);
    font-size: 12px;
    white-space: normal;
}

.psd-hierarchy-chat-message-copy {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    padding: 3px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(98, 108, 120);
    color: rgb(205, 214, 224);
}

.psd-hierarchy-chat-message-copy:hover {
    background-color: rgb(70, 78, 88);
    border-color: rgb(136, 178, 219);
}

.psd-hierarchy-chat-message-copy:active {
    background-color: rgb(58, 66, 75);
}

.psd-hierarchy-chat-message-copy-icon {
    width: 14px;
    height: 14px;
    -unity-background-image-tint-color: rgb(215, 222, 230);
}

.psd-hierarchy-chat-composer {
    margin-top: 10px;
    padding: 8px;
    background-color: rgb(42, 47, 54);
    border-width: 1px;
    border-color: rgb(66, 73, 82);
}

.psd-hierarchy-chat-draft {
    min-height: 68px;
    max-height: 110px;
}

.psd-hierarchy-chat-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.psd-hierarchy-chat-status {
    color: rgb(183, 211, 242);
    background-color: rgb(48, 78, 106);
    padding: 3px 7px;
    font-size: 10px;
}

.psd-hierarchy-chat-send {
    min-width: 86px;
    height: 26px;
}

.psd-hierarchy-chat-empty-state {
    padding: 16px;
    color: rgb(205, 212, 221);
}

.psd-hierarchy-plan-workspace {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(75, 82, 91);
    border-bottom-color: rgb(75, 82, 91);
}

.psd-hierarchy-plan-workspace-header {
    min-height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.psd-hierarchy-plan-workspace-title {
    color: rgb(244, 246, 249);
    font-size: 13px;
    unity-font-style: bold;
}

.psd-hierarchy-plan-workspace-summary {
    margin-top: 4px;
    color: rgb(173, 184, 197);
    font-size: 10px;
    white-space: normal;
}

.psd-hierarchy-plan-workspace-issues {
    margin-top: 7px;
}

.psd-hierarchy-plan-workspace-issue {
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: rgb(62, 69, 77);
}

.psd-hierarchy-plan-workspace-issue-heading {
    min-height: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.psd-hierarchy-plan-workspace-issue-state {
    flex-shrink: 0;
    min-width: 52px;
    margin-right: 7px;
    padding: 2px 5px;
    font-size: 9px;
    unity-font-style: bold;
    -unity-text-align: middle-center;
}

.psd-hierarchy-plan-workspace-state-attention {
    color: rgb(252, 226, 178);
    background-color: rgb(91, 72, 44);
}

.psd-hierarchy-plan-workspace-state-blocked {
    color: rgb(250, 205, 205);
    background-color: rgb(103, 52, 52);
}

.psd-hierarchy-plan-workspace-state-resolved {
    color: rgb(201, 232, 214);
    background-color: rgb(48, 88, 66);
}

.psd-hierarchy-plan-workspace-issue-summary {
    flex-grow: 1;
    color: rgb(232, 236, 241);
    font-size: 11px;
    white-space: normal;
}

.psd-hierarchy-plan-workspace-metadata {
    margin-top: 4px;
    color: rgb(157, 169, 183);
    font-size: 9px;
    white-space: normal;
}

.psd-hierarchy-plan-workspace-recommendation {
    margin-top: 5px;
    color: rgb(203, 214, 225);
    font-size: 10px;
    white-space: normal;
}

.psd-hierarchy-plan-workspace-actions {
    min-height: 24px;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 7px;
}

.psd-hierarchy-plan-workspace-button {
    min-width: 68px;
    height: 24px;
    margin-right: 5px;
    margin-bottom: 3px;
    padding-left: 7px;
    padding-right: 7px;
    color: rgb(210, 219, 228);
    background-color: rgb(55, 62, 70);
    border-width: 1px;
    border-color: rgb(86, 96, 107);
    font-size: 10px;
}

.psd-hierarchy-plan-workspace-button:hover {
    background-color: rgb(68, 77, 87);
    border-color: rgb(112, 141, 169);
}

.psd-hierarchy-plan-workspace-button:disabled {
    color: rgb(125, 134, 144);
    background-color: rgb(47, 51, 57);
    border-color: rgb(65, 70, 77);
}

.psd-hierarchy-plan-workspace-button-secondary {
    min-width: 72px;
    margin-right: 0;
    color: rgb(196, 220, 242);
    background-color: rgb(48, 78, 106);
    border-color: rgb(77, 119, 153);
}

.psd-hierarchy-plan-workspace-technical-details {
    margin-top: 5px;
    padding: 7px;
    color: rgb(190, 199, 210);
    background-color: rgb(26, 29, 33);
    border-left-width: 2px;
    border-left-color: rgb(100, 111, 124);
    font-size: 9px;
    white-space: normal;
}
